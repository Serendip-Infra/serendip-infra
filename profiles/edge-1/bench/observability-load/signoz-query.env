# Config C (SigNoz) query env for driver.sh, sourced by measure.sh:
# ClickHouse SQL over its HTTP interface, the same queries as A and B
# send the adapters (a 15-minute log search for one logger's "seq="
# lines, and a 1-hour per-minute memory series for it). The password is
# the SigNoz chart's fixed ClickHouse default (spec 023 T003 finding).
CH_URL="http://signoz-clickhouse.signoz:8123/?user=admin&password=27ff0399-0d3a-4bd8-919d-17c2181e6fb9"
export LOGS_URL="$CH_URL"
export METRICS_URL="$CH_URL"
export LOGS_BODY="SELECT timestamp, body FROM signoz_logs.distributed_logs_v2 WHERE ts_bucket_start >= intDiv(__FROM_MS__, 1000) - 1800 AND timestamp >= __FROM_MS__ * 1000000 AND resources_string['k8s.namespace.name'] = 'serendip-obs-load' AND resources_string['k8s.deployment.name'] = 'obs-load-__N__' AND body LIKE '%seq=%' ORDER BY timestamp DESC LIMIT 100 FORMAT JSON"
export METRICS_BODY="SELECT toStartOfMinute(toDateTime(intDiv(unix_milli, 1000))) AS t, avg(value) FROM signoz_metrics.distributed_samples_v4 WHERE metric_name = 'k8s.pod.memory.working_set' AND unix_milli >= __FROM_MS__ AND fingerprint IN (SELECT fingerprint FROM signoz_metrics.distributed_time_series_v4 WHERE metric_name = 'k8s.pod.memory.working_set' AND JSONExtractString(labels, 'k8s.namespace.name') = 'serendip-obs-load' AND JSONExtractString(labels, 'k8s.deployment.name') = 'obs-load-__N__') GROUP BY t ORDER BY t FORMAT JSON"
